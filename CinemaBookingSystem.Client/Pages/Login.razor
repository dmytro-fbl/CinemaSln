@page "/login"
@using CinemaBookingSystem.Models.ViewModels
@using CinemaBookingSystem.Client.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-center mb-4">Вхід у систему</h4>

                @if (showError)
                {
                    <div class="alert alert-danger" role="alert">
                        Невірний логін або пароль!
                    </div>
                }

                <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Name:</label>
                        <InputText @bind-Value="loginModel.Name" class="form-control" placeholder="Login" />
                        <ValidationMessage For="@(() => loginModel.Name)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пароль:</label>
                        <InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Увійти</button>
                </EditForm>

                <div class="text-center mt-3">
                    <a href="/register">Ще не зареєстровані?</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private bool showError = false;

    private async Task HandleLogin()
    {
        showError = false;

        var result = await AuthService.Login(loginModel);

        if (result)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            showError = true;
        }
    }
}