@using CinemaBookingSystem.Models.Models
@model Movie

@{
    ViewBag.Title = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="bg-secondary text-white d-flex align-items-center justify-content-center mb-3" style="height: 400px; font-size: 2rem;">
                Фото
            </div>
        </div>
        <div class="col-md-8">
            <h2>@Model.Title</h2>
            <p class="text-muted"><span class="badge bg-primary">@Model.Genre</span> | Прем'єра: @Model.ReleaseDate.ToString("dd.MM.yyyy")</p>
            <p>@Model.Description</p>
            <h4 class="text-success fw-bold">Ціна квитка: @Model.TicketPrice.ToString("0.00") грн</h4>

            <hr class="my-4" />

            <h4>Виберіть сеанс:</h4>
            @if (Model.Showtimes != null && Model.Showtimes.Any())
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @foreach (var session in Model.Showtimes.OrderBy(s => s.SessionTime))
                    {
                        <a asp-controller="Booking" asp-action="Seats" asp-route-showtimeId="@session.Id" class="btn btn-outline-primary p-3 text-start">
                            <strong class="d-block fs-5">@session.SessionTime.ToString("HH:mm")</strong>
                            <small>@session.SessionTime.ToString("dd.MM.yyyy")</small><br />
                            <small class="text-muted">Зал №@session.HallNumber</small>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3">На жаль, доступних сеансів на цей фільм поки немає.</div>
            }
        </div>
    </div>
</div>